# Copy to .env and replace every CHANGEME value. Do not commit .env.
# Generate secrets, for example: openssl rand -hex 32

ACTUAL_PASSWORD=CHANGEME
ACTUAL_ENCRYPTION_PASSWORD=
ENABLE_BANKING_APPLICATION_ID=CHANGEME
BANK_CONN_SYNC_TOKEN=CHANGEME

# Public HTTPS URL registered in your Enable Banking application.
# TLS must be terminated by your reverse proxy / Tailscale serve configuration.
BANK_CONN_BASE_URL=https://bank-connector.example.ts.net
BANK_CONN_REDIRECT_URL=https://bank-connector.example.ts.net/callback

# Only required when starting the optional actual-mcp profile.
ACTUAL_BUDGET_SYNC_ID=CHANGEME
ACTUAL_MCP_TOKEN=CHANGEME
